# Copy this file to .env for local development. .env itself is gitignored
# and must never be committed. Every value below is a PLACEHOLDER — replace
# with your own real values locally; never paste real credentials into this
# example file.

# --- Ring integration (see src/ingestion/ring/) ---
RING_ACCESS_TOKEN=replace-with-a-real-ring-bearer-token
RING_EVENT_SOURCE=ring_real
# RING_API_BASE_URL=https://api.amazonvision.com
# RING_WEBHOOK_HMAC_SECRET=replace-with-your-ring-app-hmac-signature-key

# --- Bedrock integration (see src/reasoning/bedrock/) ---
# AWS credentials themselves are NEVER read from this file or from any
# Tend-specific environment variable — they are resolved entirely by the
# AWS SDK's own standard credential provider chain (e.g. running
# `aws configure`, an IAM role, AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY set
# by your shell/CI outside of this project, SSO, etc.). Only the two
# non-secret operational values below are Tend's own configuration.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=replace-with-a-bedrock-model-id-available-in-your-account-and-region

# --- Persistent event store (see src/store/) ---
# EVENT_STORE defaults to "in_memory" when unset — omit these entirely for
# local development. Set EVENT_STORE=dynamodb to use DynamoEventStore.
# EVENT_STORE=dynamodb
# DYNAMODB_TABLE_NAME=replace-with-your-provisioned-table-name
